# Variáveis de ambiente do Lupus
# Copie este arquivo para .env e preencha com seus valores reais.
# O arquivo .env está no .gitignore — nunca commite suas chaves.

# =============================================================================
# PROVIDER DE LLM — configure qual modelo o Lupus vai usar
# =============================================================================
#
# LLM_PROVIDER: gemini | claude | openai | openai_compat  (padrão: gemini)
# LLM_MODEL   : nome do modelo (padrão varia por provider — ver abaixo)
# LLM_TEMPERATURE: temperatura, float entre 0 e 2 (padrão: 0)
#
LLM_PROVIDER=gemini

# Modelos padrão por provider (descomente e ajuste se quiser outro modelo):
# LLM_MODEL=gemini-2.5-flash          # gemini (padrão)
# LLM_MODEL=claude-3-5-haiku-20241022 # claude
# LLM_MODEL=gpt-4o-mini               # openai
#
# LLM_TEMPERATURE=0

# --- Gemini (padrão) ---
# Obtenha em: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=sua-chave-aqui

# --- Claude (provider nativo do deepagents) ---
# Obtenha em: https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sua-chave-aqui

# --- OpenAI ---
# Obtenha em: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sua-chave-aqui

# --- OpenAI-compatível (Ollama, OpenRouter, etc.) ---
# Requer LLM_PROVIDER=openai_compat + LLM_BASE_URL
# LLM_BASE_URL=http://localhost:11434/v1   # Ollama local
# LLM_BASE_URL=https://openrouter.ai/api/v1  # OpenRouter

# =============================================================================
# REPOSITÓRIO
# =============================================================================
#
# Repositório a analisar — opcional, padrão: ./srag_agent (projeto SRAG incluído no repo)
#
# Use PROJECT_PATH para apontar para um repositório local de sua escolha.
# Ver "Como escolher qual repositório analisar?" no README para mais opções.
#
# Exemplos:
# PROJECT_PATH=/Users/seu-usuario/Documents/meu-projeto-python
# PROJECT_PATH=C:\Users\seu-usuario\Documents\meu-projeto-python
# PROJECT_PATH=/home/user/workspace/seu-projeto
#
# Deixe comentado para usar o padrão (./srag_agent)
# PROJECT_PATH=/caminho/para/seu/repositorio

# =============================================================================
# OBSERVABILIDADE (opcional)
# =============================================================================
#
# LangSmith — tracing de chamadas do agente e avaliações automáticas
# Obtenha em: https://smith.langchain.com → Settings → API Keys
# Com essas variáveis definidas, todas as execuções aparecem no dashboard LangSmith.
# Sem elas, o agente funciona normalmente — o tracing simplesmente fica desativado.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=sua-chave-langsmith-aqui
LANGCHAIN_PROJECT=lupus

# =============================================================================
# LUPUSAPI — servidor HTTP (Fases 3 e 4)
# =============================================================================
#
# Estas variáveis controlam o comportamento do servidor FastAPI.
# Todas são opcionais — os valores abaixo são os padrões usados.
#
# HOST: endereço que o servidor escuta (0.0.0.0 = todas as interfaces)
# PORT: porta do servidor
# RELOAD: ativa hot-reload (só para desenvolvimento, nunca em produção)
# LOG_LEVEL: nível de log do uvicorn — debug | info | warning | error
#
# API_HOST=0.0.0.0
# API_PORT=8000
# API_RELOAD=true
# API_LOG_LEVEL=info
#
# Timeout máximo (segundos) para o agente responder uma pergunta.
# Aumente se o repositório for grande e as queries costumarem demorar.
# API_AGENT_TIMEOUT=180
