# Variáveis de ambiente do Lupus
# Copie este arquivo para .env e preencha com seus valores reais.
# O arquivo .env está no .gitignore — nunca commite suas chaves.

# Google AI Studio — obtenha em: https://aistudio.google.com/app/apikey
# Necessário para o Gemini 2.5 Flash (LLM principal + LLM-as-judge na avaliação)
GOOGLE_API_KEY=sua-chave-aqui

# Projeto analisado — opcional, padrão: ./srag_agent (projeto SRAG incluído no repo)
# Altere para apontar para qualquer outro repositório técnico
# PROJECT_PATH=/caminho/para/outro_projeto

# LangSmith — observabilidade e tracing de chamadas do agente (opcional)
# Obtenha em: https://smith.langchain.com → Settings → API Keys
# Com essas variáveis definidas, todas as execuções aparecem no dashboard LangSmith.
# Sem elas, o agente funciona normalmente — o tracing simplesmente fica desativado.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=sua-chave-langsmith-aqui
LANGCHAIN_PROJECT=lupus
